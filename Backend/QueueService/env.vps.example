DATABASE_URL=postgres://shooter:ПАРОЛЬ@127.0.0.1:5432/shooter
MATCH_SERVER_ADDRESS=api.game35.ru
# Client-facing port in match ticket. Use 443 when API is behind nginx HTTPS (not internal 5050).
MATCH_SERVER_PORT=443
ADDRESSABLES_ROOT=/opt/shooter/QueueService/addressables
BOTS_ENABLED=1
BOT_AUTO_FILL_TARGET=0
BOT_SPAWN_CHUNK=25
DB_POOL_MAX=30
QUEUE_DB_CONCURRENCY=15
MAINTENANCE_DB_CONCURRENCY=5
QUEUE_PROFILE_CACHE_TTL_MS=30000
# Yandex Games: secret from Console -> In-app purchases -> Settings
YANDEX_GAMES_SECRET_KEY=
# Enforce signed player verification for yg-* ids (auto-enabled when secret is set)
YANDEX_GAMES_AUTH_REQUIRED=1
# Reject signatures older than this many seconds (0 disables age check)
YANDEX_GAMES_SIGNATURE_MAX_AGE_SEC=86400
AI_BOTS_ENABLED=1
AI_BOT_AUTO_FILL_SOLO=1
AI_BOT_SOLO_WAIT_MS=2500
AI_BOT_THINK_HZ=10
WORKER_COUNT=4
MAX_MATCHES_PER_WORKER=50
MAX_CONCURRENT_DUEL_MATCHES=150
SERVER_TICK_RATE=30
SNAPSHOT_RATE_HZ=15
USE_BINARY_SNAPSHOTS=1
WS_MAX_BUFFERED_BYTES=524288
WS_MAX_BUFFERED_HARD_BYTES=1048576
MAX_POSE_MSG_PER_SEC=25
MAX_PING_MSG_PER_SEC=5
MATCH_TIMEOUT_SECONDS=15
